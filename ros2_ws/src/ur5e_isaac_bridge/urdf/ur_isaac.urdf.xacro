<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <!-- Official UR arm, with ros2_control swapped to the Isaac joint-topic bridge. -->
  <xacro:arg name="name" default="ur"/>
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <!-- Humble compatibility: Use the local copy of the official UR joint-control Xacro. -->
  <!-- <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/> -->
  <xacro:include filename="ur_joint_control.xacro"/>

  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="force_abs_paths" default="true"/>
  <xacro:arg name="smart_panel" default=""/>
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>
  <xacro:arg name="joint_commands_topic" default="/isaac_joint_commands"/>
  <xacro:arg name="joint_states_topic" default="/isaac_joint_states"/>

  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

  <link name="world"/>
  
  <!-- Disable default ros2_control to use DataraAI's topic-based controller. -->
  <!-- Humble compatibility: Removed unsupported force_abs_paths and smart_panel parameters. -->
  <xacro:ur_robot
    name="$(arg name)"
    generate_ros2_control_tag="false" 
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <ros2_control name="$(arg name)" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">$(arg joint_commands_topic)</param>
      <param name="joint_states_topic">$(arg joint_states_topic)</param>
      <!-- Isaac reports revolute positions wrapped to [-2pi, 2pi]. -->
      <param name="sum_wrapped_joint_states">true</param>
      <param name="trigger_joint_command_threshold">-1</param>
    </hardware>
    <xacro:ur_joint_control_description
      tf_prefix="$(arg tf_prefix)"
      initial_positions="${xacro.load_yaml(initial_positions_file)}"/>
  </ros2_control>
  
    <!-- Problem 1: Wrist camera TF frames -->

  <!-- Mount camera 5 cm from tool0 -->
  <link name="camera_link"/>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.05" rpy="0 ${-pi/2} 0"/>
  </joint>

  <!-- ROS optical frame: Z forward, X right, Y down -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  
</robot>
